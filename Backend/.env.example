# Server Configuration
POSTGRES_DB=finance
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password
POSTGRES_PORT=5432
API_PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
JWT_SECRET=your_jwt_secret_key_here
# Production (Render): set POSTGRES_URL or DATABASE_URL to the PostgreSQL
# connection string from your database provider. SUPABASE_URL below is for
# Storage/Auth APIs only and is not a PostgreSQL connection string.
POSTGRES_URL=postgresql://user:pass@host:port/dbname
# Resend alerts for API responses with HTTP 4xx/5xx status codes.
FINANCE_ERROR_RESEND_API_KEY=
FINANCE_ERROR_MAIL_FROM=
FINANCE_ERROR_MAIL_TO=
APP_PASSWORD=your_password_here

# Supabase Storage Configuration (Free tier: 1 GB storage, 2 GB bandwidth / month)
# Server-side Supabase configuration (Project Settings -> API Keys)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-publishable-key
SUPABASE_SECRET_KEY=sb_secret_your-secret-key
SUPABASE_JWKS_URL=https://your-project-id.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_BUCKET=loan-documents

# Supabase S3 Access Keys (Optional: Project Settings -> Storage -> S3 Access Keys)
SUPABASE_ACCESS_KEY_ID=
SUPABASE_SECRET_ACCESS_KEY=

# Application Version Update Configuration
LATEST_APP_VERSION=3.2.0
APP_DOWNLOAD_URL=https://github.com/Priyadharsant/Finance_Application/releases/latest
MIN_SUPPORTED_VERSION=1.0.0
