# Server Configuration
POSTGRES_DB=finance
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password
POSTGRES_PORT=5432
API_PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
JWT_SECRET=your_jwt_secret_key_here
POSTGRES_URL=postgresql://user:pass@host:port/dbname

# Supabase Storage Configuration (Free tier: 1 GB storage, 2 GB bandwidth / month)
# Get these from Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key
SUPABASE_BUCKET=loan-documents

# Supabase S3 Access Keys (Optional: Project Settings -> Storage -> S3 Access Keys)
SUPABASE_ACCESS_KEY_ID=
SUPABASE_SECRET_ACCESS_KEY=

# Application Version Update Configuration
LATEST_APP_VERSION=1.3.0
APP_DOWNLOAD_URL=https://github.com/Priyadharsant/Finance_Application/releases/latest
MIN_SUPPORTED_VERSION=1.0.0
